{
  "name": "chatgpt-desktop-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the official ChatGPT Desktop (Ubuntu) Chat surface as tools via AT-SPI",
  "type": "module",
  "license": "MIT",
  "bin": {
    "chatgpt-desktop-mcp": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:python",
    "copy:python": "mkdir -p dist/adapters/atspi/python && cp src/adapters/atspi/python/*.py dist/adapters/atspi/python/",
    "probe": "node dist/main.js probe",
    "test": "node --test tests/unit/*.test.mjs",
    "test:smoke": "node tests/smoke/e2e-smoke.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
